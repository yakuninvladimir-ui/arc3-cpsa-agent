# ==============================================================================
# ARC3 / CPSA 2.3 Agent Environment Configuration
# ==============================================================================

# --- LLM Endpoint Configuration ---
LOCAL_ANALYZER_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_ANALYZER_MODEL=flashnext
LOCAL_ANALYZER_API_KEY=EMPTY
LOCAL_ANALYZER_TEMPERATURE=0.85
LOCAL_ANALYZER_TOP_P=0.95
LOCAL_ANALYZER_TOP_K=20

# --- Context Window & Generation Budget ---
LOCAL_ANALYZER_CONTEXT_WINDOW=131072
LOCAL_ANALYZER_MAX_OUTPUT=20480
LOCAL_ANALYZER_MAX_TOKENS=20480
LOCAL_ANALYZER_ENABLE_THINKING=true
ARC3_PRESERVE_THINKING=1
ARC3_REASONING_HISTORY_KEY=reasoning_content

# --- CPSA 2.3 Context Trimming & Persistent Memory ---
ARC3_CONTEXT_DRAIN_TOKENS=32768
ARC3_CONTEXT_DRAIN_FLOOR=0
ARC3_HISTORY_ASSISTANT_TURNS=65
ARC3_HISTORY_TURN_DRAIN=12
ARC3_HISTORY_DRAIN_COALESCE=1
ARC3_CPSA_LEVEL_TRIM_BUDGET=32768
ARC3_CPSA_WIPE_HISTORY_ON_LEVEL=1
ARC3_CPSA_MUTATE_HISTORY_REASONING=0

# --- Priority Scheduler & Concurrency ---
ARC3_MAX_ACTIVE_STREAMS=16
ARC3_PRIORITY_REFRESH_QUEUE=1
ARC3_PRIORITY_PACE=0
ARC3_PRIORITY_TAIL_FADE=1
ARC3_PRIORITY_TAIL_FADE_FRACTION=0.2
ARC3_PRIORITY_TAIL_LOOKUP=remaining
ARC3_PRIORITY_SCORE_NORMALIZATION=1

# --- CPSA Core Features & Guards ---
ARC3_CPSA=1
ARC3_MEMORY_SECTIONS=off
ARC3_PERSISTENT_FUNCTIONS=1
ARC3_PERSISTENT_FUNCTIONS_SCOPE=game
ARC3_PERSISTENT_FUNCTIONS_IMPORTS=1
ARC3_CONSOLIDATION_TURN=1
ARC3_CPSA_CONSOLIDATION_MAX_TURNS=2
ARC3_NOOP_REPEAT_GUARD=1
ARC3_DEATH_REPEAT_GUARD=1
ARC3_DEATH_GUARD_LOOKAHEAD=1
ARC3_DEATH_LEDGER=1
ARC3_BATCH_NOOP_BLOCK=1
ARC3_STALE_STATE_BLOCK=1

# --- Visual & Prompting Options ---
ARC3_HISTORY_IMAGE_KEEP=24
ARC3_PRUNE_CONTROL_CONTEXT=1
ARC3_YIELD_RESUME_PROMPT=short
ARC3_YIELD_RESUME_TONE=minimal
ARC3_RESUME_PROMPT_IMAGES=0
ARC3_DIFF_IMAGE=1
ARC3_GAMEOVER_DIFF_IMAGE=1
ARC3_ANIMATION=1
